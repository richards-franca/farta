# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Local: http://localhost:3000 | Production: https://app.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set true only after Google is configured in Supabase Auth and Google Cloud.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Internal URL used only by the Next.js server. Docker uses http://api:3001.
FARTA_API_URL=http://127.0.0.1:3001
