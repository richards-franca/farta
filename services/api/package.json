    "@supabase/supabase-js": "^2.117.1",
    "fastify": "^5.0.0",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "tsup": "^8.5.0"
  }
